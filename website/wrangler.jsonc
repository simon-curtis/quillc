{
  "name": "quill-website",
  "account_id": "5291daa21d5bfc2aa14cd567d33fc550",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "../target/website",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/", "/*.md", "/docs/*", "/benchmarks/*"]
  },
  "services": [{ "binding": "ORIGINAL_SITE", "service": "quill-devlog" }],
  "routes": [{ "pattern": "quill.simoncurtis.dev/*", "zone_name": "simoncurtis.dev" }],
  "observability": { "enabled": true }
}
